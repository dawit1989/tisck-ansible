# ==============================================================================
# TISCK Offline Authentik Identity Configuration (.env.identity)
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# Core Authentik Security Secrets
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}

# Offline & Air-Gap Flags
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_LOG_LEVEL={{ authentik_log_level }}

# Database Configuration
AUTHENTIK_POSTGRESQL__HOST=auth-db
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME={{ authentik_db_name }}
AUTHENTIK_POSTGRESQL__USER={{ authentik_db_user }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_db_password }}

# Redis Cache & Task Broker
AUTHENTIK_REDIS__HOST=auth-cache
AUTHENTIK_REDIS__PORT=6379

# Ports & Network Binding
AUTHENTIK_PORT_HTTP={{ authentik_http_port }}
AUTHENTIK_PORT_HTTPS={{ authentik_https_port }}
AUTHENTIK_HOST=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}

AUTHENTIK_OUTPOSTS__DOCKER_IMAGE_BASE=ghcr.io/goauthentik/%(type)s:2024.12.3

# LDAP Outpost Configuration
AUTHENTIK_LDAP_PORT={{ authentik_ldap_port }}
AUTHENTIK_LDAPS_PORT={{ authentik_ldaps_port }}
AUTHENTIK_LDAP_BASE_DN=dc=ldap,dc=goauthentik,dc=io
AUTHENTIK_LDAP_SERVICE_USER=cn=akadmin,ou=users,dc=ldap,dc=goauthentik,dc=io

# CloudTAK OIDC Client Linking Parameters
OIDC_ENABLED=true
OIDC_FORCED=false
OIDC_DISCOVERY_URL=http://identity-server:9000/application/o/cloudtak/.well-known/openid-configuration
OIDC_AUTHORIZATION_URL=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}/application/o/authorize/
OIDC_CLIENT_ID={{ oidc_client_id }}
OIDC_CLIENT_SECRET={{ oidc_client_secret }}
OIDC_SCOPES={{ oidc_scopes }}
OIDC_REDIRECT_URI=http://{{ tisck_public_host_or_ip }}:{{ cloudtak_api_port }}/api/login/oidc/callback
OIDC_ISSUER=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}/application/o/cloudtak/
LOCAL_ONLY_ACCOUNTS=admin

# Authentik-specific CloudTAK attributes & API token
AUTHENTIK_URL=http://identity-server:9000
AUTHENTIK_APP_SLUG=cloudtak
AUTHENTIK_API_TOKEN={{ authentik_bootstrap_token }}
SYNC_AUTHENTIK_ATTRIBUTES_ON_LOGIN=true
OIDC_SYSTEM_ADMIN_GROUP=CloudTAKSystemAdmin
OIDC_AGENCY_ADMIN_GROUP_PREFIX=CloudTAKAgency
