# ==============================================================================
# tak-infra Environment Configuration (Self-Hosted TAK Server)
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# Server Domain and Identification
HostedDomain={{ tisck_public_host_or_ip }}
TAK_VERSION={{ tak_version }}
StackName=TAKServer
ORGANIZATION={{ tak_organization }}
ORGANIZATIONAL_UNIT={{ tak_organizational_unit }}
COUNTRY={{ tak_country }}
STATE={{ tak_state }}
CITY={{ tak_city }}
CAPASS={{ tak_ca_password }}
PASS={{ tak_cert_password }}

# Port Mappings (Host)
TAK_COT_PORT={{ tak_cot_port }}
TAK_WEB_PORT={{ tak_web_port }}
TAK_CERT_PORT={{ tak_cert_port }}

# Independent PostgreSQL Database (tak-db)
POSTGRES_HOST=tak-db
POSTGRES_PORT=5432
POSTGRES_DB={{ tak_db_name }}
POSTGRES_USER={{ tak_db_user }}
POSTGRES_PASSWORD={{ tak_db_password }}

# Deployed Garage S3 Storage Integration
S3_ENABLED=true
AWS_S3_Endpoint=http://garage:3900
S3_BUCKET=tak-server
AWS_S3_AccessKeyId={{ garage_key_name }}
AWS_S3_SecretAccessKey={{ garage_secret_access_key }}
AWS_REGION={{ garage_region }}
AWS_S3_ForcePathStyle=true
AWS_EC2_METADATA_DISABLED=true

# Authentik LDAP Outpost Integration
LDAP_ENABLED={{ 'true' if tisck_enable_ldap | bool else 'false' }}
LDAP_HOST=authentik-ldap
LDAP_PORT=389
LDAP_SECURE_URL=ldap://authentik-ldap:389
LDAP_DN=dc=ldap,dc=goauthentik,dc=io
LDAP_SERVICE_USER=cn=akadmin,ou=users,dc=ldap,dc=goauthentik,dc=io
LDAP_SERVICE_USER_PASSWORD={{ authentik_bootstrap_token }}

# TLS & Certificate Lifecycle
ENABLE_LETSENCRYPT=false
