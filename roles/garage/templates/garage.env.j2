# ==============================================================================
# TISCK Garage-Infra Configuration Environment
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

GARAGE_S3_PORT={{ garage_s3_port }}
GARAGE_WEB_PORT={{ garage_web_port }}
GARAGE_ADMIN_PORT={{ garage_admin_port }}

# S3 Client Configuration (for connecting services: CloudTAK, tak-infra)
AWS_REGION={{ garage_region }}
AWS_S3_Endpoint=http://127.0.0.1:{{ garage_s3_port }}
AWS_S3_AccessKeyId={{ garage_access_key_id }}
AWS_S3_SecretAccessKey={{ garage_secret_access_key }}
AWS_S3_ForcePathStyle=true
AWS_EC2_METADATA_DISABLED=true

# Buckets Provisioned by Ansible
ASSET_BUCKET=cloudtak
BASEMAP_BUCKET=tisck-basemaps
TAK_BUCKET=tak-server
