# ==============================================================================
# CloudTAK Local Deployment Configuration (.env)
# Managed by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================

# Core Server Settings
CLOUDTAK_Mode=docker-compose
CLOUDTAK_Server_Mode=both

SigningSecret={{ cloudtak_signing_secret }}

API_URL=http://{{ tisck_public_host_or_ip }}:{{ cloudtak_api_port }}
API_PORT={{ cloudtak_api_port }}

PMTILES_URL=http://tiles:{{ cloudtak_tiles_port }}
TILES_PORT={{ cloudtak_tiles_port }}

CLOUDTAK_Config_media_url=http://mediamtx:{{ media_port_rtsp }}

# TAK Server Connection (CoT Event Router)
CLOUDTAK_Hub_URL=wss://tak-server:{{ tak_web_port }}
HUB_RPC_PORT={{ cloudtak_tiles_port }}

# Database Configuration (Local PostGIS)
POSTGRES_DB={{ cloudtak_db_name }}
POSTGRES_USER={{ cloudtak_db_user }}
POSTGRES_PASSWORD={{ cloudtak_db_password }}
POSTGRES_PORT={{ cloudtak_postgres_port }}
POSTGRES=postgres://{{ cloudtak_db_user }}:{{ cloudtak_db_password }}@postgis:5432/{{ cloudtak_db_name }}

# Garage S3 Object Storage Configuration
AWS_REGION={{ garage_region }}
ASSET_BUCKET=cloudtak
AWS_S3_Endpoint=http://garage:3900
AWS_S3_AccessKeyId={{ garage_access_key_id }}
AWS_S3_SecretAccessKey={{ garage_secret_access_key }}
AWS_S3_ForcePathStyle=true
AWS_EC2_METADATA_DISABLED=true

# OpenID Connect (OIDC) Configuration
OIDC_ENABLED=true
OIDC_FORCED=false
OIDC_DISCOVERY_URL=http://authentik-server:9000/application/o/cloudtak/.well-known/openid-configuration
OIDC_AUTHORIZATION_URL=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}/application/o/authorize/
OIDC_CLIENT_ID={{ oidc_client_id }}
OIDC_CLIENT_SECRET={{ oidc_client_secret }}
OIDC_SCOPES={{ oidc_scopes }}
OIDC_REDIRECT_URI=http://{{ tisck_public_host_or_ip }}:{{ cloudtak_api_port }}/api/login/oidc/callback
OIDC_ISSUER=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}/application/o/cloudtak/
LOCAL_ONLY_ACCOUNTS=admin

# Authentik-specific settings
AUTHENTIK_HOST=http://{{ tisck_public_host_or_ip }}:{{ authentik_http_port }}
AUTHENTIK_URL=http://authentik-server:9000
AUTHENTIK_APP_SLUG=cloudtak
AUTHENTIK_API_TOKEN={{ authentik_bootstrap_token }}
SYNC_AUTHENTIK_ATTRIBUTES_ON_LOGIN=true
OIDC_SYSTEM_ADMIN_GROUP=CloudTAKSystemAdmin
OIDC_AGENCY_ADMIN_GROUP_PREFIX=CloudTAKAgency

# Tactical Group Colors & Organizational Mappings
{% for key, value in cloudtak_group_mappings.items() %}
CLOUDTAK_Config_group_{{ key }}={{ value }}
{% endfor %}

# Map & Display Defaults (Horn of Africa Baseline)
CLOUDTAK_Config_map_center={{ cloudtak_map_center }}
CLOUDTAK_Config_map_zoom={{ cloudtak_map_zoom }}
CLOUDTAK_Config_map_pitch={{ cloudtak_map_pitch }}
CLOUDTAK_Config_map_bearing={{ cloudtak_map_bearing }}
CLOUDTAK_Config_display_distance={{ cloudtak_display_distance }}
CLOUDTAK_Config_display_elevation={{ cloudtak_display_elevation }}
CLOUDTAK_Config_display_speed={{ cloudtak_display_speed }}
CLOUDTAK_Config_display_projection={{ cloudtak_display_projection }}
